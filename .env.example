# 复制为 .env 后填写；.env 已在 .gitignore 中
# cp .env.example .env

# ---- 协议 ----
# anthropic = Anthropic 消息协议（MiniMax 的 Claude 兼容端点走这个）
# openai    = OpenAI 兼容协议（通义 / DeepSeek / 月之暗面 / 智谱）
# off       = 不用 LLM，纯数据+规则模式
MA_PROTOCOL=anthropic

# ---- MiniMax（Anthropic 兼容）----
MA_API_KEY=sk-xxxx
MA_BASE_URL=https://api.minimaxi.com/anthropic
MA_MODEL=MiniMax-M2
# 若模型名不对会自动按候选列表探测：MiniMax-M2 / MiniMax-M1 / MiniMax-Text-01 / abab7-chat

# ---- 换成通义千问示例 ----
# MA_PROTOCOL=openai
# MA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MA_MODEL=qwen-plus

# ---- 换成 DeepSeek 示例 ----
# MA_PROTOCOL=openai
# MA_BASE_URL=https://api.deepseek.com
# MA_MODEL=deepseek-chat

MA_TEMPERATURE=0.3
MA_MAX_TOKENS=1500

# ---- 调试 ----
# MA_MOCK=1    # 不调 API，固定话术验证编排
